{
  "name": "bigforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BigForge: forge reasoning once, reuse it without paying to rethink it.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "synthetic-labs/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:server",
    "build:web": "npm run build -w @bigforge/web",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server/main.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:verify": "tsx scripts/demo-verify.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
